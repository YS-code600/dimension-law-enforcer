[gd_scene load_steps=5 format=3 uid="uid://game_dimension_001"]

[ext_resource type="PackedScene" path="res://levels/world_main.tscn" id="2_wm"]
[ext_resource type="PackedScene" path="res://player/player.tscn" id="4_player"]
[ext_resource type="PackedScene" path="res://levels/hud.tscn" id="5_hud"]

[sub_resource type="GDScript" id="GDScript_1_game"]
script/source = "extends Node2D\n## 单世界关卡:不再加载平行世界;任何时候按 + 直接前往火雨房间。\n\nconst FIRE_ROOM := \"res://levels/fire_room.tscn\"\nconst WALK_IN_START_X := 40.0\nconst WALK_IN_SPEED := 120.0\n\n@onready var world: Node2D = $WorldMain\n@onready var player: CharacterBody2D = $Player\n@onready var dim_label: Label = $DimLabel\n@onready var flash: ColorRect = $Flash\n\nvar _leaving := false\n\n\nfunc _ready() -> void:\n\tvar w_player := world.get_node_or_null(\"Player\")\n\tif w_player != null:\n\t\tvar cam := w_player.get_node_or_null(\"Camera2D\")\n\t\tif cam != null:\n\t\t\tcam.enabled = false\n\t\tw_player.queue_free()\n\tvar w_hud := world.get_node_or_null(\"HUD\")\n\tif w_hud != null:\n\t\tw_hud.queue_free()\n\t_start_opening_walk_in()\n\tif dim_label != null:\n\t\tdim_label.text = \"[+] 直接前往火雨房间\"\n\n\nfunc _unhandled_input(event: InputEvent) -> void:\n\tif not (event is InputEventKey):\n\t\treturn\n\tvar key := event as InputEventKey\n\tif not key.pressed or key.echo:\n\t\treturn\n\tif key.keycode == KEY_EQUAL or key.unicode == 43 or key.physical_keycode == KEY_KP_ADD:\n\t\t_jump_to_fire()\n\n\nfunc _jump_to_fire() -> void:\n\tif _leaving:\n\t\treturn\n\t_leaving = true\n\tget_viewport().set_input_as_handled()\n\t_play_flash()\n\tawait get_tree().create_timer(0.3).timeout\n\tget_tree().change_scene_to_file(FIRE_ROOM)\n\n\nfunc _start_opening_walk_in() -> void:\n\tvar spawn := world.get_node_or_null(\"PlayerSpawn\") as Node2D\n\tif spawn == null:\n\t\treturn\n\tvar ground_y := _ground_y_at(world, WALK_IN_START_X)\n\tvar y := spawn.position.y\n\tif ground_y != INF:\n\t\ty = ground_y - 1.0\n\tplayer.global_position = Vector2(WALK_IN_START_X, y)\n\tvar hint := get_node_or_null(\"HUD/CombatHint\") as CanvasItem\n\tif hint != null:\n\t\thint.visible = false\n\tif player.has_method(\"begin_walk_in\"):\n\t\tplayer.call(\"begin_walk_in\", spawn.position.x, WALK_IN_SPEED)\n\t\t_reveal_hint_after_walk_in(hint)\n\n\nfunc _reveal_hint_after_walk_in(hint: CanvasItem) -> void:\n\tif hint == null:\n\t\treturn\n\twhile is_instance_valid(player) and bool(player.get(\"_walk_in_active\")):\n\t\tawait get_tree().physics_frame\n\tif is_instance_valid(hint):\n\t\thint.visible = true\n\n\n## 目标世界 x 处最高的可站立表面 y(越小越高)。\nfunc _ground_y_at(world_node: Node2D, x: float) -> float:\n\tvar best := INF\n\tfor child in world_node.get_node(\"Terrain\").get_children():\n\t\tif not (child is StaticBody2D):\n\t\t\tcontinue\n\t\tvar pos: Vector2 = child.position\n\t\tif child.has_method(\"_points\"):\n\t\t\tvar run: float = child.get(\"run\")\n\t\t\tvar rise: float = child.get(\"rise\")\n\t\t\tvar kind: String = child.get(\"kind\")\n\t\t\tif x < pos.x or x > pos.x + run:\n\t\t\t\tcontinue\n\t\t\tvar lx := clampf(x - pos.x, 0.0, run)\n\t\t\tvar surface: float = pos.y\n\t\t\tif kind == \"down\":\n\t\t\t\tsurface = pos.y - rise + (lx / run) * rise\n\t\t\telse:\n\t\t\t\tsurface = pos.y - (lx / run) * rise\n\t\t\tbest = minf(best, surface)\n\t\telse:\n\t\t\tvar sz = child.get(\"size\")\n\t\t\tif sz == null:\n\t\t\t\tcontinue\n\t\t\tvar half_w: float = sz.x * 0.5\n\t\t\tif x < pos.x - half_w or x > pos.x + half_w:\n\t\t\t\tcontinue\n\t\t\tvar top: float = pos.y - sz.y * 0.5\n\t\t\tbest = minf(best, top)\n\treturn best\n\n\nfunc _play_flash() -> void:\n\tif flash == null:\n\t\treturn\n\tflash.modulate.a = 0.4\n\tflash.visible = true\n\tvar tw := create_tween()\n\ttw.tween_property(flash, \"modulate:a\", 0.0, 0.3)\n\ttw.tween_callback(func() -> void: flash.visible = false)\n"

[node name="Game" type="Node2D"]
script = SubResource("GDScript_1_game")

